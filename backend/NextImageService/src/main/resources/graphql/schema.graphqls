type SeenImage {
    artworkId: Int!
    seenAt: Float!
}

type UserHistory {
    seenImages: [SeenImage!]!
    preferredTimeInHours: Int!
    preferredTimeInMinutes: Int!
}

type Query {
    history: UserHistory!
}

type Mutation {
    setPreferredTime(
        preferredTimeInHours: Int!
        preferredTimeInMinutes: Int!
        timeZoneId: String!
    ): Boolean!
    setTimeZone(timeZoneId: String!): Boolean!
}
